<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"[ENABLE FIRST] Resolve UE3 Pointers &amp; Stats (ASLR-Safe AOB + Reflection)"</Description>
      <Options moHideChildren="0"/>
      <Color>0080FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(dmc_sig_GNames,DMC-DevilMayCry.exe,8B 0D ?? ?? ?? ?? 8B 3D ?? ?? ?? ?? 83 C4 04 89 1C 85 ?? ?? ?? ?? 8B 43 08)
aobscanmodule(dmc_sig_GObjects,DMC-DevilMayCry.exe,8B 15 ?? ?? ?? ?? 8B 0C B2 E8 ?? ?? ?? ?? A1 ?? ?? ?? ?? 46)
aobscanmodule(dmc_sig_GEngine,DMC-DevilMayCry.exe,83 7E 20 00 74 3D 8B 0D ?? ?? ?? ?? 83 B9 5C 06 00 00 00)
aobscanmodule(dmc_sig_StatsMap,DMC-DevilMayCry.exe,8D 4C 24 08 51 B9 ?? ?? ?? ?? E8 ?? ?? ?? ?? 8B 44 24 04 83 F8 FF)

{$lua}
if syntaxcheck then return end

local function u32(addr)
  local v = readInteger(addr)
  if not v then return 0 end
  if v &lt; 0 then return v + 4294967296 end
  return v
end

local pGNames   = u32(getAddress("dmc_sig_GNames") + 8)
local pGObjects = u32(getAddress("dmc_sig_GObjects") + 2)
local pGEngine  = u32(getAddress("dmc_sig_GEngine") + 8)
local pStatsMap = u32(getAddress("dmc_sig_StatsMap") + 6)

registerSymbol("dmc_GNames", pGNames, true)
registerSymbol("dmc_GObjects", pGObjects, true)
registerSymbol("dmc_GEngine", pGEngine, true)
registerSymbol("dmc_StatsMap", pStatsMap, true)

local targetStats = {
  "Orb_Red", "Orb_Gold", "Orb_Gold_Persistent", "Orb_GoldSpecial",
  "MundusKeyBronze", "MundusKeyBronze_Persistent",
  "MundusKeySilver", "MundusKeySilver_Persistent",
  "MundusKeyGold", "MundusKeyGold_Persistent",
  "MundusKeyIvory", "MundusKeyIvory_Persistent",
  "VitalStar_Small", "VitalStar_Small_Persistent",
  "VitalStar_Large", "VitalStar_Large_Persistent",
  "DevilTriggerStar_Small", "DevilTriggerStar_Small_Persistent",
  "DevilTriggerStar_Large", "DevilTriggerStar_Large_Persistent",
  "OrbFragment_Blue", "OrbFragment_Blue_Persistent",
  "OrbFragment_Purple", "OrbFragment_Purple_Persistent",
  "MAXHEALTH_PLAYER", "MAXHEALTH_SET",
  "MAXTRIGGERPOINTS_PLAYER", "MAXTRIGGERPOINTS_SET",
  "OTHER_GAMECOMPLETED", "OTHER_GAMECOMPLETED_HARD",
  "OTHER_GAMECOMPLETED_SOS", "OTHER_GAMECOMPLETED_DMD",
  "OTHER_GAMECOMPLETED_HOH"
}

local wantSet = {}
for _, k in ipairs(targetStats) do wantSet[k] = true end

local function readFName(gnamesData, gnamesNum, idx)
  if idx &lt; 0 or idx &gt;= gnamesNum then return nil end
  local entryPtr = u32(gnamesData + idx * 4)
  if entryPtr &lt; 0x10000 then return nil end
  local flags = u32(entryPtr + 8)
  if (flags % 2) == 1 then
    return readString(entryPtr + 16, 128, true)
  else
    return readString(entryPtr + 16, 128, false)
  end
end

local lastStatsCount = -1
dmcRegisteredStatSyms = dmcRegisteredStatSyms or {}

function dmcRefreshStatsSymbols()
  local arrData = u32(pStatsMap)
  local arrNum  = u32(pStatsMap + 4)
  if arrData &lt; 0x10000 or arrNum == 0 or arrNum &gt; 8000 then return end
  if arrNum == lastStatsCount then return end

  local gnData = u32(pGNames)
  local gnNum  = u32(pGNames + 4)
  if gnData &lt; 0x10000 or gnNum == 0 or gnNum &gt; 1000000 then return end

  local nameCache = {}
  for i = 0, arrNum - 1 do
    local base = arrData + i * 20
    local nidx = readInteger(base)
    local nnum = u32(base + 4)
    local statPtr = u32(base + 8)
    if statPtr &gt;= 0x10000 and nnum == 0 and nidx then
      local sname = nameCache[nidx]
      if not sname then
        sname = readFName(gnData, gnNum, nidx)
        nameCache[nidx] = sname or ""
      end
      if wantSet[sname] then
        local sym = "dmc_Stat_" .. sname
        registerSymbol(sym, statPtr, true)
        dmcRegisteredStatSyms[sym] = true
      end
    end
  end
  lastStatsCount = arrNum
end

dmcRefreshStatsSymbols()
if dmcStatTimer then dmcStatTimer.destroy() end
dmcStatTimer = createTimer(nil, false)
dmcStatTimer.Interval = 1500
dmcStatTimer.OnTimer = function() dmcRefreshStatsSymbols() end
dmcStatTimer.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if dmcStatTimer then
  dmcStatTimer.destroy()
  dmcStatTimer = nil
end
if dmcRegisteredStatSyms then
  for sym, _ in pairs(dmcRegisteredStatSyms) do
    unregisterSymbol(sym)
  end
  dmcRegisteredStatSyms = {}
end
unregisterSymbol("dmc_GNames")
unregisterSymbol("dmc_GObjects")
unregisterSymbol("dmc_GEngine")
unregisterSymbol("dmc_StatsMap")
{$asm}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"[Script] Never Decrease Items, Orbs &amp; Keys (Counter_Decrement AOB)"</Description>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(dmc_CounterDec,DMC-DevilMayCry.exe,8B 44 24 14 50 E8 ?? ?? ?? ?? 83 C4 04 85 C0 74 0B 8B 48 0C 85 C9 74 04 49 89 48 0C)
registersymbol(dmc_CounterDec)

dmc_CounterDec+18:
  db 90

[DISABLE]
dmc_CounterDec+18:
  db 49
unregistersymbol(dmc_CounterDec)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>3</ID>
          <Description>"[Script] One-Hit Kill (Enemies Dead in IsDead AOB, Player Safe)"</Description>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(dmc_IsDead_AOB,DMC-DevilMayCry.exe,85 C0 75 0E 0F 57 C0 0F 2F 86 40 08 00 00 73 02)
alloc(newmem_isdead,256)
label(code_isdead)
label(return_isdead)
label(player_alive)
label(enemy_onehit)

newmem_isdead:
  push eax
  mov eax,[dmc_GEngine]
  test eax,eax
  jz code_isdead
  mov eax,[eax+4DC]
  test eax,eax
  jz code_isdead
  mov eax,[eax]
  test eax,eax
  jz code_isdead
  mov eax,[eax+3C]
  test eax,eax
  jz code_isdead
  cmp [eax+808],esi
  je player_alive

enemy_onehit:
  mov dword ptr [esi+840],00000000
  jmp code_isdead

player_alive:
  comiss xmm0,[esi+840]
  jb code_isdead
  mov eax,[esi+844]
  mov [esi+840],eax

code_isdead:
  pop eax
  comiss xmm0,[esi+00000840]
  jmp return_isdead

dmc_IsDead_AOB+07:
  jmp newmem_isdead
  nop 2
return_isdead:
registersymbol(dmc_IsDead_AOB)

[DISABLE]
dmc_IsDead_AOB+07:
  db 0F 2F 86 40 08 00 00
unregistersymbol(dmc_IsDead_AOB)
dealloc(newmem_isdead)
</AssemblerScript>
