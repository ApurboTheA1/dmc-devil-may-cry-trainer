{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Trainer UI (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug Headless API (--no-browser)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": ["--no-browser", "--port", "54321"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
